{{define "page"}}{{template "public.tmpl" .}}{{end}}
{{define "title"}}{{t .Lang "server.page.coordinates.document_title"}}{{end}}
{{define "meta"}}<meta name="url-prefix" content="{{.URLPrefix}}">
<meta name="description" content="{{t .Lang "server.page.coordinates.description"}}">
    <meta name="api-base-path" content="{{.APIBasePath}}">
    <meta name="theme-color" content="#6366f1">
    <link rel="manifest" href="{{path .URLPrefix "/manifest.json"}}">{{end}}
{{define "content"}}
<main id="main-content">
        <!-- Location Section -->
        <section class="search-section">
            <div class="container container-sm">
                <div class="section-header">
                    <h1 class="section-title">{{t .Lang "coordinates.title"}}</h1>
                    <p class="section-description">{{t .Lang "coordinates.description"}}</p>
                </div>

                <form id="coordForm" class="search-form" method="get" action="{{path .URLPrefix "/coordinates"}}"
                    data-distance-label="{{t .Lang "server.page.coordinates.distance"}}"
                    data-capital-label="{{t .Lang "server.page.coordinates.capital"}}"
                    data-coordinates-label="{{t .Lang "server.page.coordinates.coordinates"}}"
                    data-timezones-label="{{t .Lang "server.page.coordinates.timezones"}}"
                    data-not-available="{{t .Lang "server.page.coordinates.not_available"}}"
                    data-geolocation-unsupported="{{t .Lang "server.page.coordinates.geolocation_unsupported"}}"
                    data-getting-location="{{t .Lang "server.page.coordinates.getting_location"}}"
                    data-location-found="{{t .Lang "server.page.coordinates.location_found"}}"
                    data-unable-location="{{t .Lang "server.page.coordinates.unable_location"}}"
                    data-location-permission-denied="{{t .Lang "server.page.coordinates.location_permission_denied"}}"
                    data-location-unavailable="{{t .Lang "server.page.coordinates.location_unavailable"}}"
                    data-location-timeout="{{t .Lang "server.page.coordinates.location_timeout"}}"
                    data-invalid-latitude="{{t .Lang "server.page.coordinates.invalid_latitude"}}"
                    data-invalid-latitude-description="{{t .Lang "server.page.coordinates.invalid_latitude_description"}}"
                    data-invalid-longitude="{{t .Lang "server.page.coordinates.invalid_longitude"}}"
                    data-invalid-longitude-description="{{t .Lang "server.page.coordinates.invalid_longitude_description"}}"
                    data-error-title="{{t .Lang "server.page.coordinates.error_title"}}"
                    data-error-description="{{t .Lang "server.page.coordinates.error_description"}}">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="lat" class="form-label">{{t .Lang "coordinates.latitude"}}</label>
                            <input
                                type="number"
                                id="lat"
                                name="lat"
                                class="form-input"
                                step="any"
                                placeholder="{{t .Lang "server.page.coordinates.latitude_placeholder"}}"
                                value="{{.Latitude}}"
                                required
                            >
                            <p class="form-hint">{{t .Lang "server.page.coordinates.latitude_range"}}</p>
                        </div>
                        <div class="form-group">
                            <label for="lon" class="form-label">{{t .Lang "coordinates.longitude"}}</label>
                            <input
                                type="number"
                                id="lon"
                                name="lon"
                                class="form-input"
                                step="any"
                                placeholder="{{t .Lang "server.page.coordinates.longitude_placeholder"}}"
                                value="{{.Longitude}}"
                                required
                            >
                            <p class="form-hint">{{t .Lang "server.page.coordinates.longitude_range"}}</p>
                        </div>
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <span class="btn-icon">📍</span>
                            {{t .Lang "coordinates.submit"}}
                        </button>
                        <button type="button" class="btn btn-secondary btn-lg" id="useLocation">
                            <span class="btn-icon">🎯</span>
                            {{t .Lang "coordinates.use_location"}}
                        </button>
                    </div>
                </form>

                {{if .Error}}
                <p class="error" role="alert">{{t .Lang "coordinates.error"}}</p>
                {{end}}
                {{if .Nearest}}
                <section class="results-section" aria-labelledby="server-nearest-title">
                    <h2 class="results-title" id="server-nearest-title">{{t .Lang "server.page.coordinates.nearest_country"}}</h2>
                    <article class="result-card">
                        <h3 class="result-card-title">{{.Nearest.Flag}} {{.Nearest.Name.Common}} ({{.Nearest.CCA2}})</h3>
                        <p>{{.Nearest.Name.Official}}</p>
                        <p>{{t $.Lang "coordinates.distance"}}: {{printf "%.2f" .Nearest.Distance}} km</p>
                    </article>
                </section>
                {{end}}

                <!-- Location Status -->
                <div id="locationStatus" class="location-status" role="status" aria-live="polite" hidden>
                    <div class="location-status-icon">📍</div>
                    <span class="location-status-text">{{t .Lang "server.page.coordinates.getting_location"}}</span>
                </div>

                <!-- Loading State -->
                <div id="loading" class="loading-state" aria-live="polite" hidden>
                    <div class="loading-spinner"></div>
                    <p>{{t .Lang "server.page.coordinates.loading"}}</p>
                </div>

                <!-- Results Section -->
                <section id="results" class="results-section" aria-live="polite" hidden>
                    <div class="results-header">
                        <h2 class="results-title">{{t .Lang "server.page.coordinates.nearest_country"}}</h2>
                    </div>
                    <div id="resultCard"></div>
                </section>

                <!-- Empty State -->
                <div id="emptyState" class="empty-state" hidden>
                    <div class="empty-state-icon">📍</div>
                    <h3 class="empty-state-title">{{t .Lang "server.page.coordinates.no_country"}}</h3>
                    <p class="empty-state-description">{{t .Lang "server.page.coordinates.no_nearby_country"}}</p>
                </div>
            </div>
        </section>

        <!-- Quick Tips -->
        <section class="features">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">{{t .Lang "server.page.coordinates.quick_tips"}}</h2>
                    <p class="section-description">{{t .Lang "server.page.coordinates.quick_tips_intro"}}</p>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">🎯</div>
                        <h3 class="feature-title">{{t .Lang "server.page.coordinates.use_location_title"}}</h3>
                        <p class="feature-description">{{t .Lang "server.page.coordinates.use_location_description"}}</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">📐</div>
                        <h3 class="feature-title">{{t .Lang "server.page.coordinates.manual_entry_title"}}</h3>
                        <p class="feature-description">{{t .Lang "server.page.coordinates.manual_entry_description"}}</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🌐</div>
                        <h3 class="feature-title">{{t .Lang "server.page.coordinates.world_coverage_title"}}</h3>
                        <p class="feature-description">{{t .Lang "server.page.coordinates.world_coverage_description"}}</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
{{end}}
