{{define "head"}}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" sizes="16x16" href="{{asset .URLPrefix "/static/icons/icon-16.png"}}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{asset .URLPrefix "/static/icons/icon-32.png"}}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{asset .URLPrefix "/static/icons/icon-180.png"}}">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="{{.AppName}}">
  {{block "meta" .}}{{end}}
  <title>{{block "title" .}}{{end}}</title>
  <link rel="stylesheet" href="{{asset .URLPrefix "/static/css/main.css"}}">
  {{trackingScript .Request}}
  {{block "head-extra" .}}{{end}}
</head>
{{end}}
