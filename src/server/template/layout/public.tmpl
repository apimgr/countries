{{define "public.tmpl"}}
<!doctype html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
{{template "head" .}}
<body>
  {{if consentRequired .Request}}<aside class="cookie-banner" role="status"><p>{{t .Lang "consent.preference_required"}} <a href="{{path .URLPrefix "/server/preferences"}}#consent-preferences">{{t .Lang "preferences.preference_cookies"}}</a></p></aside>{{end}}
  <div id="offline-indicator" class="offline-indicator" role="status" aria-live="polite" data-offline-cache="{{.AppName}}-offline-strings" data-offline-title="{{t .Lang "pwa.offline_title"}}" data-offline-message="{{t .Lang "pwa.offline_message"}}" data-offline-reload="{{t .Lang "pwa.offline_reload"}}" hidden>{{t .Lang "pwa.offline_notice"}}</div>
  {{trackingNoscript .Request}}
  <a class="skip-link" href="#main-content">{{t .Lang "nav.skip_main"}}</a>
  <a class="skip-link" href="#site-navigation">{{t .Lang "nav.skip_navigation"}}</a>
  <template id="announcement-slot"></template>
  {{template "site-header" .}}
  {{block "content" .}}{{end}}
  {{template "site-footer" .}}
  {{template "consent-banner" .}}
  {{template "scripts" .}}
</body>
</html>
{{end}}
